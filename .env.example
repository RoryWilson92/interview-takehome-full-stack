# Byteful API key pair, from https://dashboard.byteful.com/developer/api-key
# Read only by server code. Never rename these with a NEXT_PUBLIC_ prefix.
BYTEFUL_PUBLIC_KEY=
BYTEFUL_PRIVATE_KEY=

# Optional. Defaults to https://api.byteful.com/1.0
# BYTEFUL_API_URL=

# Optional. Export OpenTelemetry traces over OTLP/HTTP, for example to the
# Jaeger container in docker-compose.yml (UI at http://localhost:16686).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
